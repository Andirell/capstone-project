# Copy to backend/.env and adjust. Everything is optional for local development.

DJANGO_DEBUG=True
# Required when DJANGO_DEBUG=False. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Leave empty to use SQLite (db.sqlite3). In production use Postgres:
# DATABASE_URL=postgres://user:password@host:5432/jobz
DATABASE_URL=

# The Next.js site. Used for CORS and for links in emails.
FRONTEND_URL=http://localhost:3000
# Extra allowed origins, comma separated (defaults to FRONTEND_URL)
# CORS_ALLOWED_ORIGINS=https://jobz.vercel.app,https://www.jobz.ng

# Email. Without EMAIL_HOST, emails are printed in the terminal.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=JobZ <no-reply@yourdomain.com>
# Receives contact-form messages and applications for companies with no employer account
SITE_ADMIN_EMAIL=
